# DB_*: PostgreSQL connection (pgAdmin4 local database "snrt_db")
DB_HOST="localhost"
DB_PORT="5432"
DB_USER="postgres"
DB_PASSWORD="MY_DB_PASSWORD"
DB_NAME="snrt_db"

# JWT_SECRET: clé secrète utilisée pour signer les tokens de connexion (authentification).
# Choisissez une longue chaîne aléatoire et gardez-la privée (ne jamais la partager / commiter).
JWT_SECRET="change_this_to_a_long_random_secret"